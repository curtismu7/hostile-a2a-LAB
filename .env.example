# Copy to .env (never commit it). Real environment variables win over this file.
# 49xx is free of the other demos; change if one is taken.
PORT=4750
VITE_PORT=4751
# The server binds 127.0.0.1 only. Setting HOSTILE_BIND to another address (for example 0.0.0.0 in a container)
# is the explicit opt-in to listen off-box. The server serves hostile payloads: do not expose it to a network you do not control.
# HOSTILE_BIND=127.0.0.1

# Run observability (rule 27): "What each layer logged for this run" under the Run result. Mock only here: the rows are computed by the mock, so
# nothing below is needed. A Real record is not offered (this app has no live version). Set only for the shared panel's Elasticsearch reader:
# RUN_OBS_ES_URL must be a LOOPBACK Elasticsearch origin (a port-forward, for example http://127.0.0.1:9200); the key must be READ-ONLY (the owner creates it).
RUN_OBS_ES_URL=
RUN_OBS_ES_READ_APIKEY=
