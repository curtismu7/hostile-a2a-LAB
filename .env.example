# Copy to .env (never commit it). Real environment variables win over this file.
# 49xx is free of the other demos; change if one is taken.
PORT=4901
VITE_PORT=4902
# The server binds 127.0.0.1 only. Setting HOSTILE_BIND to another address (for example 0.0.0.0 in a container)
# is the explicit opt-in to listen off-box. The server serves hostile payloads: do not expose it to a network you do not control.
# HOSTILE_BIND=127.0.0.1
